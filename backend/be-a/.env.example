APP_ENV=local
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=15
BE_B_BASE_URL=https://wedit-be-b.onrender.com
BE_C_BASE_URL=https://wedit-be-c.onrender.com
INTERNAL_API_KEY=
PUBLIC_BASE_URL=https://wedit-be-a.onrender.com
HIGHLIGHT_OUTPUT_DIR=generated/highlights
HIGHLIGHT_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
HIGHLIGHT_CALLBACK_ENABLED=false
HIGHLIGHT_CALLBACK_RETRY_ATTEMPTS=3
HIGHLIGHT_CALLBACK_BACKOFF_SECONDS=0.25
HIGHLIGHT_STORAGE_ENABLED=true
HIGHLIGHT_STORAGE_RETRY_ATTEMPTS=3
HIGHLIGHT_STORAGE_BACKOFF_SECONDS=0.25
