# OpenAI 비전 판정용 API 키. 비워두면 판정 호출 시 AI-001 오류를 반환한다.
OPENAI_API_KEY=

# 비전 판정에 사용할 모델. gpt-4o-mini 등 이미지 입력을 지원하는 모델이어야 한다.
OPENAI_VISION_MODEL=gpt-4o-mini

# BE A(개인화 미션/판정 이유 서비스) 주소. 판정 이유 생성을 위해 BE A의
# POST /api/ai/verdicts/reason 을 호출한다. 비워두면 규칙 기반 fallback 문장을 사용한다.
BE_A_BASE_URL=http://localhost:8001

# BE C(사용자/그룹/스탬프 서비스) 주소. 판정이 끝날 때마다 BE C의
# POST /api/v1/missions/results 를 호출해 결과를 알려준다(그룹 진행률/스탬프 계산용).
# 비워두면 호출을 생략한다. 실패해도 BE B 응답에는 영향 없음(로그만 남김).
BE_C_BASE_URL=http://localhost:8080

# BE B(this) <-> BE A/BE C 간 내부 호출 인증 키.
# highlight-complete 콜백(BE A -> BE B), withdrawal-cleanup(BE C -> BE B) 호출 시
# X-Internal-Key 헤더 값과 비교한다. 비워두면 내부 API 인증을 생략한다(로컬 개발용).
INTERNAL_API_KEY=

# 사용자별 하루 AI 판정 호출 허용 횟수 (MISSION-005)
DAILY_AI_JUDGEMENT_LIMIT=10

# 미션 인스턴스당 재촬영 허용 횟수 (MISSION-003)
MAX_FAIL_RETRY_COUNT=3
MAX_TOTAL_ATTEMPT_COUNT=6

# 원본 클립 업로드 최대 용량(MB) (FILE-002)
MAX_UPLOAD_MB=20

# 공유 클립 보관 기간(시간) - 판정 완료 시점부터 계산
SHARED_CLIP_RETENTION_HOURS=24

# 비공유 클립이 highlight-complete 콜백을 영영 못 받을 때 강제 파기까지 기다리는 일수(안전장치)
NON_SHARED_CLIP_FORCE_PURGE_DAYS=7

# 로컬 파일 저장 루트 (실제 운영에서는 외부 스토리지/오브젝트 스토리지로 교체)
STORAGE_ROOT=storage

# 이 서비스를 외부에서 접근할 때 쓰는 base URL. sourceClipUrl/frameUrl 생성에 사용.
# Render 등에 배포할 때는 실제 배포 도메인(예: https://wedit-be-b.onrender.com)으로 반드시 바꿔야
# 응답의 sourceClipUrl/frameUrl이 외부에서 접근 가능한 주소로 내려간다.
PUBLIC_BASE_URL=http://localhost:8002

# SQLite DB 파일 경로
DATABASE_PATH=storage/clips.db
